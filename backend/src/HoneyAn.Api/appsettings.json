{
  "Jwt": {
    "Issuer": "HoneyAn.Api",
    "Audience": "HoneyAn.Backoffice",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "AuthCookie": {
    "RefreshCookieName": "honeyan.refresh",
    "CsrfCookieName": "honeyan.csrf",
    "CsrfHeaderName": "X-CSRF-TOKEN",
    "Path": "/api/v1/auth",
    "Secure": true,
    "SameSite": "Strict"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
